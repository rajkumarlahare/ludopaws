<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LudoPaws" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#03153F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Dedicated native launch theme. The transparent icon lets SplashActivity
         render its full-screen branded WebP layout without the launcher icon. -->
    <style name="Theme.LudoPaws.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#03153F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ludo_paws_home_hero</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.LudoPaws.SplashContent</item>
    </style>
    <!-- Keep the launch window artwork visible until SplashActivity draws its live layout. -->
    <style name="Theme.LudoPaws.SplashContent" parent="@style/Theme.LudoPaws">
        <item name="android:windowBackground">@drawable/ludo_paws_splash_window_background</item>
    </style>
</resources>
