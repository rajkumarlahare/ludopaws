{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ludoproof-game-api",
  "main": "src/index-account.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.ludopaws.rekixo.com/*",
      "zone_name": "rekixo.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LUDOPROOF_MATCHES",
        "class_name": "MatchRoom"
      },
      {
        "name": "LUDOPROOF_API_GATE",
        "class_name": "ApiGate"
      },
      {
        "name": "LUDOPROOF_LEADERBOARD",
        "class_name": "LeaderboardRoom"
      },
      {
        "name": "LUDOPROOF_MATCHMAKER",
        "class_name": "MatchmakerQueue"
      },
      {
        "name": "LUDOPROOF_FRIENDS",
        "class_name": "FriendDirectory"
      },
      {
        "name": "LUDOPROOF_RECEIPTS",
        "class_name": "MatchReceiptArchive"
      },
      {
        "name": "LUDOPROOF_TEAM_MATCHMAKER",
        "class_name": "TeamMatchmakerQueue"
      },
      {
        "name": "LUDOPROOF_FRIEND_CONVERSATIONS",
        "class_name": "FriendConversation"
      },
      {
        "name": "LUDOPROOF_FRIEND_RECENT",
        "class_name": "FriendRecentRoom"
      },
      {
        "name": "LUDOPROOF_STORE_PURCHASES",
        "class_name": "StorePurchaseLedger"
      },
      {
        "name": "LUDOPROOF_ACCOUNT_DIRECTORY",
        "class_name": "AccountDirectory"
      },
      {
        "name": "LUDOPROOF_PLAYER_ACCOUNTS",
        "class_name": "PlayerAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MatchRoom"
      ]
    },
    {
      "tag": "v2-rate-gate",
      "new_sqlite_classes": [
        "ApiGate"
      ]
    },
    {
      "tag": "v3-leaderboard",
      "new_sqlite_classes": [
        "LeaderboardRoom"
      ]
    },
    {
      "tag": "v4-matchmaker",
      "new_sqlite_classes": [
        "MatchmakerQueue"
      ]
    },
    {
      "tag": "v5-friends",
      "new_sqlite_classes": [
        "FriendDirectory"
      ]
    },
    {
      "tag": "v6-match-receipts",
      "new_sqlite_classes": [
        "MatchReceiptArchive"
      ]
    },
    {
      "tag": "v7-team-matchmaker",
      "new_sqlite_classes": [
        "TeamMatchmakerQueue"
      ]
    },
    {
      "tag": "v8-friend-social",
      "new_sqlite_classes": [
        "FriendConversation",
        "FriendRecentRoom"
      ]
    },
    {
      "tag": "v9-store-purchases",
      "new_sqlite_classes": [
        "StorePurchaseLedger"
      ]
    },
    {
      "tag": "v10-account-directory",
      "new_sqlite_classes": [
        "AccountDirectory"
      ]
    },
    {
      "tag": "v11-player-accounts",
      "new_sqlite_classes": [
        "PlayerAccount"
      ]
    }
  ],
  "vars": {
    "ENTRONEX_BASE_URL": "https://entronex-v4-eval.ai-8f3.workers.dev",
    "ENTRONEX_SIGNING_KEY_ID": "cf-v4-eval-sign-1",
    "ENTRONEX_TENANT_ID": "cloudflare_v4_eval",
    "ENTRONEX_SIGNING_KEY_FINGERPRINT": "1fe248e8ee9129fcd13c1ee96c1cd7d162a610e9b1df3037a4ec48935f2d43c4",
    "ENTRONEX_SIGNING_PUBLIC_KEY_PEM_B64": "LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQTVlaXhuL3QvV1lYQWhPTEgvOEMybXZTRk8vRHk0Ti93UDhxQ2x4SEtnMUU9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo="
  },
  "services": [
    {
      "binding": "ENTRONEX_SERVICE",
      "service": "entronex-v4-eval"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
